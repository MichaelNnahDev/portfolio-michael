                <div class="stack-pill">PHP 8.2 (MU-Plugins)</div>
                <div class="stack-pill">WooCommerce Core</div>
                <div class="stack-pill">Elementor Engine</div>
                <div class="stack-pill">JavaScript (ES6+)</div>
