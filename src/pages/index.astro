    <!-- Deferred Interactive Scripts -->
    <script is:inline>
      // 1. Accessible Terminal Tab Switcher
      const termData = [
        `<div><span class="c-prompt">$</span> <span class="c-cmd">node -v && astro --version && next --version</span></div>
<div class="c-dim">Node Runtime: v20.x LTS (x86_64)</div>
<div class="c-dim">Frontend Core: Astro 4.x (SSG/Edge) + Next.js 14+</div>
<div class="c-dim">Decoupled Systems: Headless WooCommerce GraphQL Active</div>
<div class="c-dim">Security: Strict CSP & Grade-A HTTP Headers Verified</div>
<br>
<div><span class="c-prompt">$</span> <span class="c-cmd">verify_fullstack_mesh</span></div>
<div>[✓] Astro SSG Engine: <span class="c-green">OPTIMIZED</span></div>
<div>[✓] Official WP.org Plugin Assets: <span class="c-green">VERIFIED</span></div>`,

        `<div><span class="c-prompt">$</span> <span class="c-cmd">wp-plugin verify-status --slug="flashproof-sales-popup-for-woo"</span></div>
<div class="c-dim">Repository: Official WordPress.org Plugin Directory</div>
<div class="c-dim">Standard: WP Coding Standards & Nonce Security Passed</div>
<div class="c-dim">Compatibility: PHP 8.x + WooCommerce Core Hooks</div>
<br>
<div><span class="c-prompt">$</span> <span class="c-cmd">git svn-deploy --channel=stable</span></div>
<div>[✓] Deployment: <span class="c-green">STABLE RELEASE LIVE</span></div>`,

        `<div><span class="c-prompt">$</span> <span class="c-cmd">aws sts get-caller-identity && aws ec2 describe-instances</span></div>
<div class="c-dim">Target Cloud: Amazon Web Services (AWS)</div>
<div class="c-dim">Architecture: High-Availability EC2 + Decoupled Amazon RDS</div>
<div class="c-dim">Backup Route: Encrypted Daily Snapshots to S3 Bucket</div>
<br>
<div><span class="c-prompt">$</span> <span class="c-cmd">check_redundancy_health</span></div>
<div>[✓] Load Balancer (ALB) Health: <span class="c-green">HEALTHY (100%)</span></div>`
      ];

      const tabs = document.querySelectorAll('.term-tab');
      const output = document.getElementById('termOutput');

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t, i) => {
            const isActive = i === index;
            t.classList.toggle('active', isActive);
            t.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
          output.innerHTML = termData[index];
          output.setAttribute('aria-labelledby', tab.id);
        });
      });

      // 2. High-Performance Three.js Loader (Post-Interaction / Idle Only)
      let threeLoaded = false;
      const initThreeMesh = () => {
        if (threeLoaded) return;
        threeLoaded = true;

        ['touchstart', 'scroll', 'mousemove'].forEach((evt) =>
          window.removeEventListener(evt, initThreeMesh)
        );

        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
        script.async = true;
        script.onload = () => {
          const canvas = document.getElementById('webgl-bg');
          if (!canvas || typeof THREE === 'undefined') return;

          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
          camera.position.z = 26;

          const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: false, powerPreference: 'low-power' });
          renderer.setSize(window.innerWidth, window.innerHeight);
          renderer.setPixelRatio(1);

          const geometry = new THREE.TorusKnotGeometry(9, 2.2, 50, 12, 2, 3);
          const material = new THREE.MeshBasicMaterial({
            color: 0xE6CA65,
            wireframe: true,
            transparent: true,
            opacity: 0.12
          });

          const mesh = new THREE.Mesh(geometry, material);
          scene.add(mesh);

          let mouseX = 0, mouseY = 0;
          let targetX = 0, targetY = 0;

          window.addEventListener('mousemove', (e) => {
            targetX = (e.clientX / window.innerWidth - 0.5) * 1.2;
            targetY = (e.clientY / window.innerHeight - 0.5) * 1.2;
          }, { passive: true });

          window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
          }, { passive: true });

          function renderLoop() {
            mouseX += (targetX - mouseX) * 0.05;
            mouseY += (targetY - mouseY) * 0.05;
            mesh.rotation.x += 0.0015 + mouseY * 0.006;
            mesh.rotation.y += 0.002 + mouseX * 0.006;
            renderer.render(scene, camera);
            requestAnimationFrame(renderLoop);
          }
          renderLoop();
        };
        document.body.appendChild(script);
      };

      ['touchstart', 'scroll', 'mousemove'].forEach((evt) =>
        window.addEventListener(evt, initThreeMesh, { passive: true, once: true })
      );
      setTimeout(initThreeMesh, 4000);
    </script>
  </body>
