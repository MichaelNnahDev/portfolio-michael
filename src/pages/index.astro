        </section>

        <!-- Engineer Bio -->
        <section class="engineer-section" aria-label="About the Engineer">
          <div class="engineer-image-wrapper">
            <img
              src="/images/profile.webp"
              alt={`${bio?.name || "Michael Nnah"} - ${bio?.title || "WordPress Performance and Cloud Infrastructure Engineer"}`}
              width="320"
              height="397"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="engineer-bio">
            <h3>{bio?.name || "Michael Nnah"}</h3>
            <span class="engineer-title">{bio?.title || "WordPress Performance & Cloud Infrastructure Engineer"}</span>
            <p>
              {bio?.bioParagraph1 || "I operate at the intersection of custom WordPress development and Linux cloud administration. While many freelancers rely heavily on off-the-shelf plugins that cause database drag and security vulnerabilities, my workflow centers on clean PHP hooks, custom MU-plugins, and terminal-level optimization."}
            </p>
            <p>
              {bio?.bioParagraph2 || "Whether configuring zero-downtime Cloudflare edge proxies, hardening Hostinger origin nodes with Grade-A HTTP headers, or automating encrypted daily MySQL snapshots to Amazon S3, every site is engineered for peak conversion and continuous uptime."}
            </p>
            <div class="guarantee-box">
              <span class="guarantee-icon" aria-hidden="true">&lowast;</span>
              <div class="guarantee-text">
                <strong>{bio?.guaranteeHeading || "The Zero-Downtime Migration Standard:"}</strong>{' '}
                {bio?.guaranteeText || "Every DNS cutover, database transition, and CDN edge deployment is engineered with low-TTL propagation bridges and transactional integrity — protecting active checkouts and customer orders from disruption."}
              </div>
            </div>
          </div>
        </section>

        <!-- Comparison Matrix -->
        <section class="comparison-section" aria-label="Engineering Standards Comparison">
          <span class="section-tag">{matrix?.sectionTag || "Engineering Difference"}</span>
          <h2 class="section-h2" style="font-size: clamp(1.4rem, 3.5vw, 1.8rem); margin-bottom: 8px;">
            {matrix?.heading || "Code-First Engineering vs Plugin Overload"}
          </h2>
          <p style="color: var(--text-muted); font-size: 0.92rem;">
            {matrix?.subheading || "Direct comparisons of how these production environments operate compared to generic site setups."}
          </p>

          <div class="table-scroll">
            <table class="comp-table">
              <thead>
                <tr>
                  <th scope="col">Architecture Vector</th>
                  <th scope="col">Standard WordPress Freelancer</th>
                  <th scope="col">My Custom Engineering Approach</th>
                </tr>
              </thead>
              <tbody>
                {matrix?.rows && matrix.rows.length > 0 ? (
                  matrix.rows.map((row: any) => (
                    <tr>
                      <th scope="row">{row.vector}</th>
                      <td>{row.standardApproach}</td>
                      <td class="focus-gold">{row.myApproach}</td>
                    </tr>
                  ))
                ) : (
                  <>
                    <tr>
                      <th scope="row">Checkout &amp; Features</th>
                      <td>Installs 3–5 heavy third-party plugins</td>
                      <td class="focus-gold">Lightweight PHP Snippets (Payment Proof, Modals &amp; Popups)</td>
                    </tr>
                    <tr>
                      <th scope="row">Security &amp; SEO Graph</th>
                      <td>Unconfigured shared headers</td>
                      <td class="focus-gold">Grade-A HTTP Security Headers + Lightweight PHP Social Graph</td>
                    </tr>
                    <tr>
                      <th scope="row">Origin &amp; Edge Routing</th>
                      <td>Standard DNS with migration downtime</td>
                      <td class="focus-gold">Hardened Hostinger Origin + Zero-Downtime Cloudflare Edge</td>
                    </tr>
                    <tr>
                      <th scope="row">Backups &amp; Redundancy</th>
                      <td>Manual local zip exports</td>
                      <td class="focus-gold">Automated Daily Encrypted Snapshots to Amazon S3</td>
                    </tr>
                  </>
                )}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Footer Call to Action -->
        <footer class="footer-cta">
          <h2>{cta?.heading || "Need Enterprise-Grade WordPress?"}</h2>
          <p style="color: var(--text-muted); max-width: 520px; margin: 0 auto 28px auto; font-size: 0.95rem;">
            {cta?.description || "Available for zero-downtime migrations, plugin-free WooCommerce custom engineering, and automated cloud retainers."}
          </p>
          <a href={cta?.buttonUrl || "https://www.upwork.com"} target="_blank" rel="noopener noreferrer" class="btn-gold">
            {cta?.buttonText || "Hire on Upwork Today →"}
          </a>
        </footer>
      </main>
    </div>

    <!-- Deferred Interactive Scripts -->
    <script is:inline>
      // 1. Accessible Terminal Tab Switcher
      const termData = [
        `<div><span class="c-prompt">$</span> <span class="c-cmd">wp --info && check_mesh_status</span></div>
<div class="c-dim">OS: Linux Ubuntu 22.04 LTS (x86_64)</div>
<div class="c-dim">Origin: Hostinger Origin Infrastructure <span class="c-green">[HARDENED]</span></div>
<div class="c-dim">Security: Grade-A HTTP Security Headers Verified</div>
<div class="c-dim">SEO Engine: Native Social Graph PHP Active Across All 6 Sites</div>
<br>
<div><span class="c-prompt">$</span> <span class="c-cmd">verify_custom_code</span></div>
<div>[✓] Custom Checkout (Proof Upload): <span class="c-green">ACTIVE</span></div>
<div>[✓] Social Proof Popup Engine: <span class="c-green">RUNNING</span></div>`,

        `<div><span class="c-prompt">$</span> <span class="c-cmd">cloudflare-cli --zone-verify --all</span></div>
<div class="c-dim">Edge Proxy: Cloudflare Enterprise Anycast CDN</div>
<div class="c-dim">SSL/TLS: Strict (End-to-End Encryption)</div>
<div class="c-dim">Migration Downtime: <span class="c-green">0.00 Seconds (Active Proxy)</span></div>
<br>
<div><span class="c-prompt">$</span> <span class="c-cmd">edge-cache-purge --smart</span></div>
<div>[✓] Edge Cache Revalidated: <span class="c-green">100% OK</span></div>`,

        `<div><span class="c-prompt">$</span> <span class="c-cmd">cat /etc/cron.daily/s3_backup.sh</span></div>
<div class="c-dim">Target: s3://production-vault/backups/</div>
<div class="c-dim">MySQL Dump: Compressed GZ + AES-256</div>
<div class="c-dim">Automated Update: Verified Plugin Core Health</div>
<br>
<div><span class="c-prompt">$</span> <span class="c-cmd">aws s3 ls --human-readable</span></div>
<div>[✓] Backup Status: <span class="c-green">SYNCHRONIZED DAILY</span></div>`
      ];

      const tabs = document.querySelectorAll('.term-tab');
      const output = document.getElementById('termOutput');

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t, i) => {
            const isActive = i === index;
            t.classList.toggle('active', isActive);
            t.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
          output.innerHTML = termData[index];
          output.setAttribute('aria-labelledby', tab.id);
        });
      });

      // 2. High-Performance Three.js Loader (Post-Interaction / Idle Only)
      let threeLoaded = false;
      const initThreeMesh = () => {
        if (threeLoaded) return;
        threeLoaded = true;

        ['touchstart', 'scroll', 'mousemove'].forEach((evt) =>
          window.removeEventListener(evt, initThreeMesh)
        );

        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
        script.async = true;
        script.onload = () => {
          const canvas = document.getElementById('webgl-bg');
          if (!canvas || typeof THREE === 'undefined') return;

          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
          camera.position.z = 26;

          const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: false, powerPreference: 'low-power' });
          renderer.setSize(window.innerWidth, window.innerHeight);
          renderer.setPixelRatio(1);

          const geometry = new THREE.TorusKnotGeometry(9, 2.2, 50, 12, 2, 3);
          const material = new THREE.MeshBasicMaterial({
            color: 0xE6CA65,
            wireframe: true,
            transparent: true,
            opacity: 0.12
          });

          const mesh = new THREE.Mesh(geometry, material);
          scene.add(mesh);

          let mouseX = 0, mouseY = 0;
          let targetX = 0, targetY = 0;

          window.addEventListener('mousemove', (e) => {
            targetX = (e.clientX / window.innerWidth - 0.5) * 1.2;
            targetY = (e.clientY / window.innerHeight - 0.5) * 1.2;
          }, { passive: true });

          window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
          }, { passive: true });

          function renderLoop() {
            mouseX += (targetX - mouseX) * 0.05;
            mouseY += (targetY - mouseY) * 0.05;
            mesh.rotation.x += 0.0015 + mouseY * 0.006;
            mesh.rotation.y += 0.002 + mouseX * 0.006;
            renderer.render(scene, camera);
            requestAnimationFrame(renderLoop);
          }
          renderLoop();
        };
        document.body.appendChild(script);
      };

      ['touchstart', 'scroll', 'mousemove'].forEach((evt) =>
        window.addEventListener(evt, initThreeMesh, { passive: true, once: true })
      );
      setTimeout(initThreeMesh, 4000);
    </script>
  </body>
</html>
