        <!-- Developer Repositories -->
        <section class="github-section" id="open-source" aria-label="Open Source Work">
          <span class="section-tag">Open-Source Code &amp; DevOps Blueprints</span>
          <h2 class="section-h2">Developer Repositories &amp; Modules</h2>

          <div class="github-grid">
            {repos && repos.length > 0 ? (
              repos.map((repo: any) => (
                <div class="github-card">
                  <div>
                    <div class="gh-header">
                      <span class="gh-name">{repo.name}</span>
                      <span class="gh-icon" aria-hidden="true">&prop;</span>
                    </div>
                    <p class="gh-desc">{repo.description}</p>
                  </div>
                  <div class="gh-footer">
                    <span class="gh-lang">
                      <span class={`gh-lang-dot ${repo.languageDotClass || 'dot-php'}`}></span>{' '}
                      {repo.languageText}
                    </span>
                    <a href={repo.repoUrl} target="_blank" rel="noopener noreferrer" class="gh-link">
                      Inspect Code &nearr;
