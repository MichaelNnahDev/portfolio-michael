---
// src/pages/index.astro
// Static build with zero runtime server overhead
import { client } from '../lib/sanity.js';

// Batch fetch all portfolio data from Sanity
const query = `{
  "projects": *[_type == "project"] | order(orderRank asc){
    _id,
    title,
    subtitle,
    liveUrl,
    tags,
    orderRank
  },
  "hero": *[_type == "heroSection"][0],
  "techStack": *[_type == "techStackSection"][0],
  "repos": *[_type == "repository"] | order(orderRank asc){
    _id,
    name,
    description,
    languageText,
    languageDotClass,
    repoUrl,
    orderRank
  },
  "bio": *[_type == "engineerBio"][0],
  "matrix": *[_type == "comparisonMatrix"][0],
  "cta": *[_type == "ctaSection"][0]
}`;

const { projects, hero, techStack, repos, bio, matrix, cta } = await client.fetch(query);

const whatsappUrl = "https://wa.me/2348109957259?text=" + encodeURIComponent("I am interested in your web development services coming from your portfolio");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>Michael Nnah | Full-Stack Web Developer & Cloud Infrastructure Engineer</title>
    <meta
      name="description"
      content="Full-stack web developer specializing in Astro, Next.js, Headless WordPress architectures, published WordPress plugins, and AWS cloud infrastructure."
    />
    <link rel="canonical" href="https://portfolio.michaelnnah.com/" />

    <style is:inline>
      :root {
        --bg-base: #0B0C10;
        --card-surface: rgba(18, 20, 26, 0.88);
        --border-subtle: #20242D;
        --border-gold: #E6CA65;
        --gold-primary: #E6CA65;
        --gold-deep: #D4AF37;
        --gold-glow: rgba(230, 202, 101, 0.18);
        --text-pure: #FFFFFF;
        --text-alabaster: #F4F4F6;
        --text-muted: #9CA3AF;
        --emerald-green: #10B981;
        --focus-blue: #60a5fa;
        --font-heading: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-mono: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background-color: var(--bg-base);
        color: var(--text-alabaster);
        font-family: var(--font-body);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
      }

      /* WCAG 2.1 AA Keyboard Navigation Skip Link */
      .skip-link {
        position: absolute;
        top: -999px;
        left: 1rem;
        background: var(--gold-primary);
        color: #0B0C10;
        padding: 0.6rem 1.2rem;
        font-weight: 700;
        border-radius: 4px;
        z-index: 9999;
        text-decoration: none;
      }
      .skip-link:focus {
        top: 1rem;
      }

      /* Strict Accessible Focus Rings */
      *:focus-visible {
        outline: 3px solid var(--focus-blue) !important;
        outline-offset: 3px !important;
      }

      /* Three.js Background Canvas with Strict Containment */
      #webgl-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 1;
        pointer-events: none;
        opacity: 0.28;
        contain: strict;
      }

      /* Content Container */
      .shell-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1320px;
        margin: 0 auto;
        padding: clamp(30px, 6vw, 80px) clamp(16px, 4vw, 36px);
      }

      /* Status Pill Badge */
      .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 999px;
        background: rgba(230, 202, 101, 0.08);
        border: 1px solid rgba(230, 202, 101, 0.35);
        color: var(--gold-primary);
        font-family: var(--font-mono);
        font-size: clamp(0.72rem, 1.8vw, 0.8rem);
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 22px;
        backdrop-filter: blur(8px);
      }

      .pulse-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--emerald-green);
        box-shadow: 0 0 10px var(--emerald-green);
        animation: livePulse 2s infinite ease-in-out;
      }

      @keyframes livePulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.85); }
      }

      /* Hero Layout */
      .hero-layout {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: clamp(24px, 4vw, 48px);
        align-items: center;
        margin-bottom: clamp(60px, 8vw, 100px);
      }

      .hero-h1 {
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: clamp(2.2rem, 5.2vw, 3.8rem);
        line-height: 1.12;
        letter-spacing: -0.02em;
        color: var(--text-pure);
        margin-bottom: 20px;
        text-transform: uppercase;
      }

      .gold-highlight {
        color: var(--gold-primary);
        background: linear-gradient(135deg, #FFFFFF 20%, var(--gold-primary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-p {
        font-size: clamp(0.95rem, 2.2vw, 1.08rem);
        color: var(--text-muted);
        max-width: 580px;
        margin-bottom: 32px;
        line-height: 1.65;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .btn-gold, .btn-ghost {
        min-height: 48px;
        padding: 12px 28px;
        border-radius: 8px;
        font-family: var(--font-heading);
        font-size: 0.92rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
      }

      .btn-gold {
        background: var(--gold-primary);
        color: #0B0C10;
        font-weight: 700;
      }

      .btn-gold:hover {
        background: #FFFFFF;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px var(--gold-glow);
      }

      .btn-ghost {
        background: rgba(18, 20, 26, 0.6);
        color: var(--text-pure);
        font-weight: 600;
        border: 1px solid var(--border-subtle);
        backdrop-filter: blur(10px);
      }

      .btn-ghost:hover {
        border-color: var(--gold-primary);
        background: rgba(230, 202, 101, 0.05);
        color: var(--gold-primary);
      }

      /* Terminal Console */
      .terminal-box {
        background: rgba(11, 13, 18, 0.95);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 24px 50px rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(16px);
        width: 100%;
      }

      .terminal-tabs {
        background: #12141A;
        display: flex;
        border-bottom: 1px solid var(--border-subtle);
        overflow-x: auto;
      }

      .term-tab {
        padding: 12px 18px;
        min-height: 44px;
        font-family: var(--font-mono);
        font-size: 0.74rem;
        color: var(--text-muted);
        border: none;
        border-right: 1px solid var(--border-subtle);
        cursor: pointer;
        background: transparent;
        transition: background 0.2s ease, color 0.2s ease;
        white-space: nowrap;
      }

      .term-tab.active {
        color: var(--gold-primary);
        background: rgba(230, 202, 101, 0.08);
        border-bottom: 2px solid var(--gold-primary);
      }

      .terminal-content {
        padding: clamp(14px, 3vw, 22px);
        font-family: var(--font-mono);
        font-size: clamp(0.75rem, 1.8vw, 0.84rem);
        color: #D1D5DB;
        line-height: 1.6;
        min-height: 230px;
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .c-prompt { color: var(--gold-primary); }
      .c-cmd { color: #FFFFFF; font-weight: 600; }
      .c-green { color: var(--emerald-green); font-weight: 600; }
      .c-dim { color: #9CA3AF; }

      /* Tech Stack Chips */
      .stack-section {
        margin-bottom: clamp(60px, 8vw, 90px);
      }

      .section-tag {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--gold-primary);
        margin-bottom: 14px;
        display: block;
        font-weight: 600;
      }

      .stack-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .stack-pill {
        background: var(--card-surface);
        border: 1px solid var(--border-subtle);
        padding: 8px 16px;
        border-radius: 6px;
        font-family: var(--font-mono);
        font-size: clamp(0.75rem, 1.8vw, 0.82rem);
        color: var(--text-pure);
        backdrop-filter: blur(8px);
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .stack-pill:hover {
        border-color: var(--gold-primary);
        transform: translateY(-2px);
        box-shadow: 0 6px 18px var(--gold-glow);
      }

      /* Production Projects Grid */
      .projects-section {
        margin-bottom: clamp(60px, 8vw, 90px);
      }

      .section-h2 {
        font-family: var(--font-heading);
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        font-weight: 800;
        color: var(--text-pure);
        text-transform: uppercase;
        letter-spacing: -0.01em;
        margin-bottom: 28px;
      }

      .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
        gap: 22px;
        width: 100%;
      }

      .project-card {
        background: var(--card-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: clamp(22px, 3.5vw, 32px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 360px;
        backdrop-filter: blur(12px);
        transition: transform 0.2s ease, border-color 0.2s ease;
        width: 100%;
      }

      .project-card:hover {
        border-color: var(--gold-primary);
        transform: translateY(-3px);
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.75), 0 0 20px var(--gold-glow);
      }

      .card-h3 {
        font-family: var(--font-heading);
        font-size: clamp(1.3rem, 2.5vw, 1.55rem);
        font-weight: 700;
        color: var(--text-pure);
        margin-bottom: 6px;
      }

      .card-subtitle {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 18px;
      }

      .tags-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 24px;
      }

      .p-tag {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        background: #0B0C10;
        border: 1px solid var(--border-subtle);
        padding: 4px 8px;
        border-radius: 4px;
        color: #D1D5DB;
        line-height: 1.3;
      }

      .p-tag-gold {
        border-color: rgba(230, 202, 101, 0.45);
        color: var(--gold-primary);
        background: rgba(230, 202, 101, 0.08);
        font-weight: 600;
      }

      .launch-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 44px;
        color: var(--gold-primary);
        font-family: var(--font-mono);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        text-decoration: none;
        transition: gap 0.2s ease, color 0.2s ease;
        margin-top: auto;
      }

      .project-card:hover .launch-link {
        gap: 10px;
        color: #FFFFFF;
      }

      /* Open Source Repositories */
      .github-section {
        margin-bottom: clamp(60px, 8vw, 90px);
      }

      .github-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
        gap: 20px;
        width: 100%;
      }

      .github-card {
        background: var(--card-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: clamp(20px, 3vw, 26px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 240px;
        backdrop-filter: blur(12px);
        transition: transform 0.2s ease, border-color 0.2s ease;
        width: 100%;
      }

      .github-card:hover {
        border-color: var(--gold-primary);
        transform: translateY(-3px);
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.75), 0 0 16px var(--gold-glow);
      }

      .gh-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
      }

      .gh-icon {
        color: var(--gold-primary);
        font-size: 1.1rem;
        flex-shrink: 0;
      }

      .gh-name {
        font-family: var(--font-mono);
        font-size: 0.94rem;
        font-weight: 700;
        color: var(--text-pure);
        word-break: break-word;
      }

      .gh-desc {
        font-size: 0.86rem;
        color: var(--text-muted);
        line-height: 1.55;
        margin-bottom: 18px;
      }

      .gh-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
      }

      .gh-lang {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: #D1D5DB;
      }

      .gh-lang-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
      }

      .dot-php { background: #4F5D95; }
      .dot-bash { background: #89E051; }
      .dot-js { background: #F1E05A; }
      .dot-config { background: var(--gold-primary); }

      .gh-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        min-height: 44px;
        color: var(--gold-primary);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
        letter-spacing: 0.04em;
        transition: gap 0.2s ease, color 0.2s ease;
      }

      .github-card:hover .gh-link {
        gap: 8px;
        color: #FFFFFF;
      }

      /* Engineer Bio Section */
      .engineer-section {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: clamp(24px, 4vw, 48px);
        align-items: center;
        background: var(--card-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: clamp(24px, 4vw, 40px);
        margin-bottom: clamp(60px, 8vw, 90px);
        backdrop-filter: blur(12px);
        width: 100%;
      }

      .engineer-image-wrapper {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-subtle);
        max-width: 320px;
        margin: 0 auto;
        width: 100%;
      }

      .engineer-image-wrapper img {
        width: 100%;
        height: auto;
        aspect-ratio: 768 / 953;
        display: block;
        filter: grayscale(15%) contrast(105%);
        transition: filter 0.3s ease;
      }

      .engineer-image-wrapper:hover img {
        filter: grayscale(0%) contrast(100%);
      }

      .engineer-bio h3 {
        font-family: var(--font-heading);
        font-size: clamp(1.4rem, 3vw, 1.8rem);
        font-weight: 800;
        color: var(--text-pure);
        margin-bottom: 6px;
        text-transform: uppercase;
      }

      .engineer-title {
        font-family: var(--font-mono);
        font-size: 0.82rem;
        color: var(--gold-primary);
        margin-bottom: 18px;
        display: block;
        font-weight: 600;
      }

      .engineer-bio p {
        font-size: 0.95rem;
        color: var(--text-muted);
        line-height: 1.65;
        margin-bottom: 16px;
      }

      .guarantee-box {
        background: rgba(11, 12, 16, 0.85);
        border: 1px solid rgba(230, 202, 101, 0.3);
        border-radius: 8px;
        padding: 14px 18px;
        margin-top: 20px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
      }

      .guarantee-icon {
        color: var(--gold-primary);
        font-size: 1.2rem;
        line-height: 1;
      }

      .guarantee-text {
        font-size: 0.86rem;
        color: var(--text-alabaster);
        line-height: 1.5;
      }

      /* Comparison Matrix */
      .comparison-section {
        background: var(--card-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: clamp(20px, 4vw, 40px);
        margin-bottom: clamp(60px, 8vw, 90px);
        backdrop-filter: blur(12px);
        width: 100%;
      }

      .table-scroll {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      .comp-table {
        width: 100%;
        min-width: 580px;
        border-collapse: collapse;
        margin-top: 18px;
      }

      .comp-table th, .comp-table td {
        padding: 14px 18px;
        text-align: left;
        border-bottom: 1px solid var(--border-subtle);
        font-size: clamp(0.82rem, 1.8vw, 0.9rem);
      }

      .comp-table th {
        font-family: var(--font-mono);
        text-transform: uppercase;
        color: var(--text-muted);
        font-size: 0.75rem;
        letter-spacing: 0.06em;
      }

      .comp-table td.focus-gold {
        color: var(--gold-primary);
        font-weight: 600;
      }

      /* Footer CTA */
      .footer-cta {
        text-align: center;
        padding: clamp(36px, 6vw, 64px) 20px;
        background: radial-gradient(circle at center, rgba(230, 202, 101, 0.08) 0%, transparent 70%);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        backdrop-filter: blur(12px);
      }

      .footer-cta h2 {
        font-family: var(--font-heading);
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        font-weight: 800;
        color: var(--text-pure);
        text-transform: uppercase;
        margin-bottom: 10px;
      }

      /* Mobile 360–414px Viewport Constraints */
      @media (max-width: 960px) {
        .hero-layout, .engineer-section {
          grid-template-columns: 1fr;
          gap: 36px;
        }
      }

      @media (max-width: 480px) {
        .shell-container {
          padding: 24px 14px;
        }
        .hero-actions {
          flex-direction: column;
          width: 100%;
          gap: 12px;
        }
        .btn-gold, .btn-ghost {
          width: 100%;
        }
        .project-card, .github-card {
          padding: 20px;
        }
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <!-- Animated Torus Knot WebGL Canvas -->
    <canvas id="webgl-bg" aria-hidden="true"></canvas>

    <div class="studio-shell">
      <main id="main" class="shell-container">
        <!-- Hero Section -->
        <section class="hero-layout" aria-label="Introduction">
          <div>
            <div class="status-badge">
              <span class="pulse-indicator" aria-hidden="true"></span>
              <span>{hero?.statusBadgeText || "Full-Stack Web & AWS Cloud Architect • Available for Work"}</span>
            </div>
            <h1 class="hero-h1">
              {hero?.headingPrefix || "Modern Frontend"}{' '}
              <span class="gold-highlight">{hero?.headingHighlight || "& Cloud"}</span>{' '}
              {hero?.headingSuffix || "Architecture."}
            </h1>
            <p class="hero-p">
              {hero?.paragraph || "Bridging modern JavaScript ecosystems (Astro, Next.js, Node.js) with production-hardened backend engineering. From decoupled headless WordPress architectures and official WordPress.org plugins to high-availability AWS migrations and Linux system automation."}
            </p>
            <div class="hero-actions">
              <a href={hero?.primaryBtnUrl || "#projects"} class="btn-gold">
                {hero?.primaryBtnText || "Explore Live Systems →"}
              </a>
              <a href={hero?.secondaryBtnUrl || whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">
                {hero?.secondaryBtnText || "Send a DM on WhatsApp"}
              </a>
            </div>
          </div>

          <!-- Interactive Terminal Card -->
          <div class="terminal-box" role="region" aria-label="Telemetry Terminal Console">
            <div class="terminal-tabs" role="tablist">
              <button class="term-tab active" role="tab" aria-selected="true" aria-controls="termOutput" id="tab-0">fullstack-mesh.sh</button>
              <button class="term-tab" role="tab" aria-selected="false" aria-controls="termOutput" id="tab-1">wp-org-deploy.sh</button>
              <button class="term-tab" role="tab" aria-selected="false" aria-controls="termOutput" id="tab-2">aws-infra.bash</button>
            </div>
            <div class="terminal-content" id="termOutput" role="tabpanel" aria-labelledby="tab-0" tabindex="0">
<div><span class="c-prompt">$</span> <span class="c-cmd">node -v &amp;&amp; astro --version &amp;&amp; next --version</span></div>
<div class="c-dim">Node Runtime: v20.x LTS (x86_64)</div>
<div class="c-dim">Frontend Core: Astro 4.x (SSG/Edge) + Next.js 14+</div>
<div class="c-dim">Decoupled Systems: Headless WooCommerce GraphQL Active</div>
<div class="c-dim">Security: Strict CSP &amp; Grade-A HTTP Headers Verified</div>
<br/>
<div><span class="c-prompt">$</span> <span class="c-cmd">verify_fullstack_mesh</span></div>
<div>[✓] Astro SSG Engine: <span class="c-green">OPTIMIZED</span></div>
